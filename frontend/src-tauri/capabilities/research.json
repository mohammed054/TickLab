{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "research",
  "description": "Permissions for the TickLab Research desktop window",
  "windows": ["research"],
  "permissions": [
    "core:default",
    "dialog:default",
    {
      "identifier": "fs:allow-write-text-file",
      "allow": [
        { "path": "$DOWNLOAD/**" },
        { "path": "$DESKTOP/**" },
        { "path": "$DOCUMENT/**" }
      ]
    }
  ]
}
