{
  "name": "ticklab-radar",
  "version": "1.0.0",
  "description": "TickLab Radar - Solana launch research workstation (read-only, no keys, no orders)",
  "main": "./out/main/index.js",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint src tests --ext .ts,.tsx",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "dist": "electron-vite build && electron-builder --win --x64",
    "p0:capture": "node scripts/p0/capture.mjs",
    "p0:rpc": "node scripts/p0/rpc.mjs",
    "p0:report": "node scripts/p0/fields.mjs",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@tanstack/react-virtual": "3.14.13",
    "better-sqlite3": "13.0.3",
    "bs58": "5.0.0",
    "electron-log": "5.4.4",
    "lightweight-charts": "4.2.0",
    "lucide-react": "1.52.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.6",
    "zod": "3.25.76",
    "zustand": "4.5.7"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "22.20.5",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "7.18.0",
    "@vitejs/plugin-react": "4.7.0",
    "electron": "33.4.11",
    "electron-builder": "25.1.8",
    "electron-vite": "2.3.0",
    "eslint": "8.57.1",
    "jsdom": "24.1.3",
    "prettier": "3.9.9",
    "typescript": "5.9.3",
    "vite": "5.4.21",
    "vitest": "2.1.9"
  }
}
